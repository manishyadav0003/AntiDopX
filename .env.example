# ==============================================================================
# AntiDopX Environment Configuration Template (.env.example)
#
# IMPORTANT SECURITY RULES:
# 1. Copy this file to '.env' for local development.
# 2. DO NOT commit '.env' or any sensitive secrets to version control (Git).
# 3. DO NOT place actual user personal data (PII) into environment files.
# 4. 'EXPO_PUBLIC_' prefixes expose variables to the React Native client bundle.
#    Variables without this prefix remain server/build-side only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Designated Single Administrator Configuration
# ------------------------------------------------------------------------------
# Set this to the Firebase Authentication UID of the single authorized administrator.
# Only accounts matching this UID (or verified by server-side custom claims)
# are permitted access to administrative routes and Firestore mutations.
EXPO_PUBLIC_ADMIN_UID=admin_designated_uid_placeholder

# Server-side administration secret (NEVER prefix with EXPO_PUBLIC_)
ADMIN_SECRET_KEY=secure_server_admin_key_placeholder

# ------------------------------------------------------------------------------
# 2. Firebase Client Configuration
# ------------------------------------------------------------------------------
# Standard client-accessible Firebase mobile/web identifiers
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCQB5tA5BkvAoFmyzntXnSu6Pi9LRO5ERA
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=antidopx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=antidopx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=antidopx.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=431858822021
EXPO_PUBLIC_FIREBASE_APP_ID=1:431858822021:web:6b353132c8fa5e443332ec

# ------------------------------------------------------------------------------
# 3. Third-Party Integrations
# ------------------------------------------------------------------------------
# Google Cloud OAuth Web Client ID for Google Authentication
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Anti-Doping AI Assistant Provider (Optional server-side key)
AI_COACH_API_KEY=server_ai_provider_key_placeholder
